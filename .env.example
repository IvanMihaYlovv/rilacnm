# Copy to .env and fill in. Never commit .env.
# Real environment variables take precedence over this file.

# ---------- Core ----------
# 1 only for local development. Leave it out (or 0) in production.
DJANGO_DEBUG=0

# Required in production (50+ random characters). Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Required in production. Comma-separated host names: list both the www and the bare domain.
DJANGO_ALLOWED_HOSTS=www.rila-cnm.eu,rila-cnm.eu

# Comma-separated full origins allowed to submit forms over HTTPS.
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.rila-cnm.eu,https://rila-cnm.eu

# Canonical public address used in SEO tags and the sitemap.
SITE_URL=https://www.rila-cnm.eu

# Admin path. Pick something not guessable instead of the default admin/.
DJANGO_ADMIN_URL=admin/

# ---------- HTTPS ----------
# How many reverse proxies (nginx, the hosting platform) sit in front of Django.
# Usually 1 in production. It makes Django trust X-Forwarded-Proto for HTTPS and read
# the visitor's IP from X-Forwarded-For (for the admin lockout and the form throttle).
# Leave 0 if visitors connect to Django directly, or the headers could be forged.
DJANGO_TRUSTED_PROXY_COUNT=0
# HSTS starts at one hour. Raise it once HTTPS is proven:
# DJANGO_HSTS_SECONDS=31536000
# Applies HSTS to all subdomains and allows preloading. Hard to undo.
# DJANGO_HSTS_PRELOAD=1

# ---------- Storage (optional; defaults are inside the project folder) ----------
# DJANGO_SQLITE_PATH=/srv/rilacnm/data/db.sqlite3
# DJANGO_STATIC_ROOT=/srv/rilacnm/staticfiles
# DJANGO_MEDIA_ROOT=/srv/rilacnm/media
# Files attached to quote requests. Must NOT be served by the web server.
# DJANGO_PRIVATE_MEDIA_ROOT=/srv/rilacnm/private
# DJANGO_CACHE_DIR=/srv/rilacnm/cache

# ---------- Logging ----------
# DJANGO_LOG_LEVEL=INFO

# ---------- Email ----------
# Leave EMAIL_HOST empty to not send: emails go to sent-emails/ (development) or the log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# TLS is on by default for port 587, SSL for port 465.
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# Sender address. Most mail providers require it to be the EMAIL_HOST_USER account.
DEFAULT_FROM_EMAIL=

# Who is notified of each inquiry and contact message (comma-separated).
# Defaults to cnm_rila@abv.bg; set it empty to turn the notifications off.
CONTACT_NOTIFY_EMAILS=cnm_rila@abv.bg

# ---------- Search Console ----------
# Token from the "HTML tag" verification method; the tag is omitted when empty.
GOOGLE_SITE_VERIFICATION=
