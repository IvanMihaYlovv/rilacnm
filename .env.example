# Copy to .env for local development. Never commit .env.

# Local development only. Leave this out in production.
DJANGO_DEBUG=1

# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# DJANGO_SECRET_KEY=

# Required in production: list both the www and bare domains.
# DJANGO_ALLOWED_HOSTS=www.rila-cnm.eu,rila-cnm.eu

# HSTS starts at one hour. Raise it once HTTPS is proven:
# DJANGO_HSTS_SECONDS=31536000
# Applies HSTS to all subdomains and allows preloading. Hard to undo.
# DJANGO_HSTS_PRELOAD=1
